{
  "ConnectionStrings": {
    "Crawler": "Host=localhost;Port=5432;Database=crawler;Username=crawler;Password=crawler",
    "RabbitMq": "amqp://crawler:crawler@localhost:5672"
  },
  "Crawl": {
    "DefaultMaxDepth": 2,
    "MaxDepthLimit": 5,
    "MaxPagesPerJob": 200
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
